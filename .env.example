# Copy jadi .env lokal: cp .env.example .env
# Untuk deploy online (Render/Railway): isi dengan DB online, bukan localhost.

# Database (lokal)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=nobarly
# Set true kalau DB online mewajibkan SSL (Aiven / TiDB / PlanetScale)
DB_SSL=false

# Server
SERVER_PORT=5000
# PORT otomatis diisi Render — jangan diisi manual saat deploy
# PORT=

# WAJIB ganti saat deploy: string acak panjang min. 32 karakter
JWT_SECRET=ganti-ini-dengan-string-acak-yang-panjang-minimal-32-karakter

# Cloudinary (gambar permanen saat deploy; kosongkan = simpan ke folder uploads/ lokal)
# Daftar gratis: cloudinary.com → Dashboard
# CLOUDINARY_CLOUD_NAME=xxx
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcdefghij1234567890

# Versi app (tampil di APK + /api/version)
APP_VERSION=2.11.0
# Link download APK terbaru (opsional, untuk tombol Update di floating modal)
# APK_URL=https://github.com/username/nobarly/releases/latest
# Changelog update (tampil di floating modal Update, \n = baris baru)
# UPDATE_MESSAGE=Hapus server tag • Customize gabung Edit Profile ala Discord • Floating update versi + changelog + tombol Update/Nanti

# Login sosial (opsional — kosongkan = tombol disembunyikan otomatis)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# GITHUB_CLIENT_ID=xxx
# GITHUB_CLIENT_SECRET=xxx
# Redirect callback (default = domain server ini + /api/auth/oauth/...):
# OAUTH_BASE_URL=https://nobarly-server-production.up.railway.app
